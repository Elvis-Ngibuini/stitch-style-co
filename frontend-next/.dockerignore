# =============================================================================
# Frontend .dockerignore
# Exclude files not needed in Docker build context
# =============================================================================

# Git
.git
.gitignore
.github

# Documentation
*.md
!README.md
CHANGELOG.md
LICENSE

# Environment files
.env
.env.*
!.env.example

# Dependencies
node_modules
.pnp
.pnp.js
.yarn/install-state.gz

# Next.js build outputs
.next
out
build

# Test & Coverage
coverage
.nyc_output
__tests__
tests
test
*.test.js
*.test.ts
*.test.tsx
*.spec.js
*.spec.ts
*.spec.tsx
jest.config.js
jest.setup.js

# IDE & Editor
.idea
.vscode
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Cache
.cache
.eslintcache
.stylelintcache
.tsbuildinfo
.next/cache

# Docker
.dockerignore
Dockerfile*
docker-compose*
.docker/

# Misc
*.pem
.vercel
.netlify

# TypeScript
*.tsbuildinfo
next-env.d.ts